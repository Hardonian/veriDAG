{
  "name": "@veridag/sdk",
  "version": "1.0.0",
  "description": "Veridag Official TypeScript SDK: deterministic, capability-scoped transaction builder and client",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "test": "node tests/conformance.test.mjs && node tests/client.test.mjs",
    "verify-package": "node -e \"import('./dist/index.js').then(m=>{if(!m.VeridagClient)process.exit(1)})\"",
    "prepack": "npm run clean && npm run build && npm test && npm run verify-package"
  },
  "keywords": [
    "veridag",
    "blockchain",
    "stablecoin",
    "usdv",
    "ethereum",
    "sdk"
  ],
  "author": "Veridag Protocol Contributors",
  "license": "Apache-2.0 OR MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
